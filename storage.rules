rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // User images and post attachments
    match /images/{userId}/{allPaths=**} {
      // Anyone can view uploaded post images and avatars
      allow read: if true;
      // Only the authenticated owner can upload or delete their images (max 10MB, images only)
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
