rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Reserved usernames check
    function isNotReservedUsername(username) {
      return !(username in [
        'dashboard', 'login', 'signup', 'register', 'api', 'admin',
        'new', 'edit', 'onboarding', 'auth', 'settings', 'user', 'users',
        'post', 'posts', 'explore', 'terms', 'privacy', 'help', 'support',
        'about', 'contact', 'pricing', 'app', 'replytome', 'replyto'
      ]);
    }

    // Users collection
    match /users/{userId} {
      // Anyone can read public user profile details
      allow read: if true;
      // Only the authenticated user can create/update/delete their own profile
      allow create, update, delete: if isOwner(userId);
    }

    // Username mapping (for unique handle claim)
    match /usernames/{username} {
      allow read: if true;
      // Only authenticate user can claim a username for themselves if not reserved
      allow create: if isAuthenticated() 
                    && request.resource.data.uid == request.auth.uid
                    && isNotReservedUsername(username);
      allow update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // Posts collection
    match /posts/{postId} {
      // Anyone can read published posts
      // Note: for sensitive comment-gate content, locked blocks are served via server /api/unlock route
      allow read: if resource.data.status == 'published' 
                  || (isAuthenticated() && resource.data.uid == request.auth.uid);
      
      // Only the author can create or edit their own posts
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }
  }
}
